# URL du proxy LiteLLM à administrer
LITELLM_BASE_URL=https://ai.proxy.gautiersa.fr

# Master key du proxy LiteLLM (ne jamais committer la vraie valeur)
LITELLM_MASTER_KEY=sk-changeme

# Clé utilisée pour protéger l'accès à CE serveur (header X-App-Api-Key).
# Laisser vide uniquement en développement local isolé.
APP_API_KEY=change-me-please

# Timeout des requêtes vers le proxy LiteLLM, en secondes
REQUEST_TIMEOUT_SECONDS=60
